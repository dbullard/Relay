<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>relay</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Relay Dashboard</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.relay.dashboard</string>
				<string>com.relay.dashboard.legacy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.relay.pco.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.relay.pco</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.relay.youtube.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.relay.youtube</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_ndi._tcp</string>
		<string>_relay._tcp</string>
		<string>_proapiv1ws._tcp</string>
		<string>_pro7._tcp</string>
		<string>_pro6._tcp</string>
		<string>_propresenter._tcp</string>
		<string>_pro7proremote._tcp</string>
		<string>_pro6proremote._tcp</string>
		<string>_elg._tcp</string>
		<string>_companion-link._tcp</string>
		<string>_ssc._tcp</string>
		<string>_shure-control._tcp</string>
		<string>_shure-audio._udp</string>
		<string>_shure-update._tcp</string>
		<string>_netaudio-arc._udp</string>
		<string>_netaudio-chan._udp</string>
		<string>_netaudio-cm._udp</string>
		<string>_http._tcp</string>
	</array>
	<key>RELAY_API_BASE_URL</key>
	<string>$(RELAY_API_BASE_URL)</string>
	<key>PCO_OAUTH_CLIENT_ID</key>
	<string>$(PCO_OAUTH_CLIENT_ID)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Relay Dashboard</string>
			<key>UTTypeIdentifier</key>
			<string>com.relay.dashboard</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>relay</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-relay-dashboard</string>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Relay Dashboard Legacy</string>
			<key>UTTypeIdentifier</key>
			<string>com.relay.dashboard.legacy</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pld</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>YOUTUBE_OAUTH_CLIENT_ID_IOS</key>
	<string>$(YOUTUBE_OAUTH_CLIENT_ID_IOS)</string>
	<key>YOUTUBE_OAUTH_REDIRECT_URI_IOS</key>
	<string>$(YOUTUBE_OAUTH_REDIRECT_URI_IOS)</string>
</dict>
</plist>
